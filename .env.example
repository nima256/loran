# ---------------------------------------------------------------------------
# Loran — environment template.
#
# Copy to `.env` and fill in. Every value below is a BLANK PLACEHOLDER: no real
# credential belongs in this file or anywhere else in the repository.
#
# Production start-up validates these (see src/server/lib/env.ts) and refuses to
# boot if a required one is missing, so a misconfigured deploy fails loudly
# rather than at the first checkout.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV="production"
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/loran?schema=public"
# Public origin, no trailing slash. Must be https:// in production — the
# ZarinPal callback URL is built from it.
SITE_URL="https://loranworld.com"

# --- Secrets ---------------------------------------------------------------
# Generate each with: openssl rand -base64 48
# Minimum 32 characters in production. Rotating SESSION_SECRET signs everyone out.
SESSION_SECRET=""
# Keys the OTP HMAC. Keep it distinct from SESSION_SECRET.
OTP_SECRET=""

# Session lifetimes.
SESSION_TTL_DAYS="30"
ADMIN_SESSION_TTL_HOURS="12"

# --- OTP -------------------------------------------------------------------
OTP_EXPIRES_SECONDS="120"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="5"
# Local development only: skips the SMS provider and returns the code in the
# API response. Production start-up REFUSES to boot while this is true.
OTP_MOCK="false"

# --- MeliPayamak SMS -------------------------------------------------------
# Shared key from the MeliPayamak console. Requests go to
# POST https://console.melipayamak.com/api/send/shared/{sharedKey}
MELIPAYAMAK_SHARED_KEY=""
# Pattern (bodyId) for the login code. Template takes one argument: the code.
MELIPAYAMAK_OTP_BODY_ID=""
# Optional. Order registered — arguments: customer name, order number.
MELIPAYAMAK_ORDER_BODY_ID=""
# Optional. Order shipped — arguments: order number, tracking code.
MELIPAYAMAK_SHIPPED_BODY_ID=""

# --- ZarinPal --------------------------------------------------------------
# The Merchant ID is a SERVER secret. It is never exposed to the browser and is
# deliberately not editable from the admin settings screen.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
# Loran prices in Tomans. Set to "rial" only if the gateway account expects Rials.
ZARINPAL_AMOUNT_UNIT="toman"
# Local development only: marks orders paid without contacting the gateway.
# Production start-up REFUSES to boot while this is true.
PAYMENT_MOCK="false"

# --- Administrator ---------------------------------------------------------
# Used by `npm run db:seed` to create (or reset the password of) the single
# administrator. Re-running the seed rotates the password to this value, which
# is the recovery path for a forgotten one.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Uploads ---------------------------------------------------------------
# Product images. Point at a persistent volume — a container's local disk is
# wiped on redeploy.
UPLOAD_DIR="./public/uploads"
UPLOAD_PUBLIC_PREFIX="/uploads"
UPLOAD_MAX_BYTES="5242880"

# --- Cookies / proxy -------------------------------------------------------
COOKIE_SAMESITE="lax"
# Set to "true" only when the app really sits behind a reverse proxy, otherwise
# a client could spoof X-Forwarded-For past the IP rate limits.
TRUST_PROXY="false"
